    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch server",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/client",
            "output": "${workspaceFolder}/bin/server",
            "env": {
                "TYPE" : "SERVER",
            }
        },
        {
            "name": "Launch client",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/client",
            "output": "${workspaceFolder}/bin/client",
            "env": {
                "TYPE" : "CLIENT",
            },
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Go Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/cmd/client",
            "args": [],
            "showLog": true,
            "env": {},
            "buildFlags": ""
          },
    ],

    "compounds": [
    {
      "name": "Server + Client",
      "configurations": ["Launch server", "Launch client"]
    }
  ]
}